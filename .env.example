# Copy to .env.local (git-ignored) and fill in.
# All values are server-only. Never prefix secrets with NEXT_PUBLIC_.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Stable audio + structured-output model. Override only after multilingual evaluation.
GEMINI_MODEL=gemini-3.8-flash
# Guide narration via Gemini API generateContent, single prebuilt voice; server-only.
# Cloud TTS's flash-lite model is a separate service and is not supported here.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Backend ownership signing secret, >=32 characters. Generate with:
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
# Set separately in the host's secret manager; rotating it revokes owner cookies.
SESSION_SECRET=
# Exact trusted application origin, no path/query. Use HTTPS in production.
APP_ORIGIN=http://localhost:3000

# Firebase Admin (Firestore).
# Default: leave the client email and private key empty to use Application Default
# Credentials (Firebase App Hosting, Cloud Run, or `gcloud auth application-default login`).
# FIREBASE_PROJECT_ID is optional with ADC.
# Hosts without ADC (e.g. Vercel): set all three. Keep the \n escapes in the private key.
FIREBASE_PROJECT_ID=local-to-lens
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: use the local Firestore emulator (read automatically by firebase-admin).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
